{
  "name": "compass-personal-life-manager",
  "private": true,
  "version": "0.5.80",
  "type": "module",
  "workspaces": [
    "client",
    "worker"
  ],
  "scripts": {
    "dev:web": "npm run dev -w client",
    "dev:api": "npm run dev -w worker",
    "build": "npm run build -w client",
    "check": "npm run check -w worker && npm run test",
    "test": "node --test tests/*.test.mjs",
    "deploy:api": "npm run deploy -w worker",
    "db:local": "npm run db:local -w worker",
    "db:remote": "npm run db:remote -w worker",
    "test:release": "node --test tests/compass-fullsource-25-10-deploy.test.mjs tests/compass-057759402510-unified-focus.test.mjs tests/compass-057759402510-watch-sql.test.mjs tests/gtd-0410-worker-purge.test.mjs tests/watch-bridge.test.mjs tests/gtd-0511-productivity-health.test.mjs tests/gtd-0410-occasion-activity.test.mjs tests/compass-0579-mobile-finance.test.mjs",
    "check:deploy": "node scripts/check-import-graph.mjs && npm run check -w worker && npm run test:release"
  },
  "engines": {
    "node": ">=20"
  }
}
