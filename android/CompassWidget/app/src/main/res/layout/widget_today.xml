<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/rounded_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="COMPASS · HEUTE" android:textSize="12sp" android:textStyle="bold" android:textColor="#356857"/>
    <TextView android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:contentDescription="Widget aktualisieren" android:textColor="#356857"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Heute" android:textSize="12sp" android:textColor="#70857A"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
     <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="28sp" android:textStyle="bold" android:textColor="#244C37"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  offene Aufgaben heute" android:textSize="12sp" android:textColor="#3B6A52"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verbinde das Widget im Companion" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#345E47"/>
  <TextView android:id="@+id/widget_health" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keine Daten" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="#6C8575"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_today_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Heute" android:gravity="center" android:padding="7dp" android:textStyle="bold" android:textSize="11sp" android:textColor="#295F50"/>
    <TextView android:id="@+id/widget_capture_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+ Erfassen" android:gravity="center" android:padding="7dp" android:textStyle="bold" android:textSize="11sp" android:textColor="#295F50"/>
    <TextView android:id="@+id/widget_recovery_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Erholung" android:gravity="center" android:padding="7dp" android:textStyle="bold" android:textSize="11sp" android:textColor="#295F50"/>
    <TextView android:id="@+id/widget_setup" android:layout_width="34dp" android:layout_height="wrap_content" android:text="⚙" android:gravity="center" android:padding="7dp" android:textSize="17sp" android:contentDescription="Widget einrichten" android:textColor="#295F50"/>
  </LinearLayout>
</LinearLayout>
