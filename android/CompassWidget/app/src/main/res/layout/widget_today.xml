<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="11dp" android:background="@drawable/widget_surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="◈  COMPASS · FOKUS" android:textSize="11sp" android:textStyle="bold" android:textColor="#2E7058"/>
  <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heute" android:textSize="10sp" android:textColor="#849C8C"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="↻" android:textSize="20sp" android:contentDescription="Daten aktualisieren" android:textColor="#397C62"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_primary_panel" android:padding="12dp" android:layout_marginTop="5dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DEIN NÄCHSTER SCHRITT" android:textSize="9sp" android:textStyle="bold" android:textColor="#C2DFCF"/>
  <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="5dp" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:text="Jetzt fokussieren"/>
  <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#D4E7DA" android:maxLines="1" android:ellipsize="end" android:text="Nächste Aktion"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_secondary_panel" android:padding="8dp">
   <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="21sp" android:textColor="#275640" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  Heute" android:textSize="10sp" android:textColor="#668578"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_secondary_panel" android:padding="8dp" android:layout_marginLeft="7dp">
   <TextView android:id="@+id/widget_waiting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="21sp" android:textColor="#275640" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  Waiting" android:textSize="10sp" android:textColor="#668578"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
  <TextView android:id="@+id/widget_second" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#789389" android:text="Weitere Schritte"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_capture_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:gravity="center" android:text="＋ Erfassen" android:textSize="11sp" android:textStyle="bold" android:textColor="#204E3D" android:background="@drawable/widget_action_panel"/>
  <TextView android:id="@+id/widget_today_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="35dp" android:gravity="center" android:text="Heute öffnen  ↗" android:textSize="11sp" android:textStyle="bold" android:textColor="#204E3D" android:layout_marginLeft="7dp" android:background="@drawable/widget_action_panel"/>
  <TextView android:id="@+id/widget_setup" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="In der Compass-App einrichten"/>
 </LinearLayout>
</LinearLayout>
